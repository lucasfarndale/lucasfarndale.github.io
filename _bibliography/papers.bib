@article{farndale2025selfsupervised,
  abbr={bioRxiv},
  title={Self-Supervised AI Reveals a Hidden Landscape of Prognostic Spatial Patterns in Multiplex Immunofluorescence Images},
  author={Farndale, Lucas and Rakovic, Kai and Hatthakarnkul, P. and Szalma, S. and Schubert Santana, L. P. and Martinelli, S. and Ballantyne, F. and Baird, R. L. and Powley, I. R. and Officer-Jones, L. and Maka, N. and Roxburgh, C. and Miller, C. J. and Chang, D. and Edwards, J. and Roberts, E. W. and Le Quesne, John and Yuan, Ke},
  journal={bioRxiv},
  year={2025},
  month={oct},
  doi={10.1101/2025.10.16.682563},
  url={https://doi.org/10.1101/2025.10.16.682563},
  note={Preprint. L.F. and K.R. contributed equally; J.L.Q. and K.Y. jointly supervised.},
  abstract={Modern spatial proteomic methods, such as multiplex immunofluorescence (mIF) imaging, offer a data-rich view of spatial biology in intact tissues. However, interpreting its complexity is a major bottleneck, limiting its potential for biological discovery and clinical translation. Current computational methods often rely on segmentation-based approaches that discard crucial morphological information and are limited to testing pre-defined hypotheses. Here, we introduce a self-supervised learning (SSL) framework that enables hypothesis-agnostic, context-aware discovery of biomarkers directly from mIF images. Our approach extracts rich feature representations that capture holistic architectural patterns, which integrate cellular morphology, marker interactions, and microenvironmental context without human supervision. Applying this framework to over 7,000 mIF tissue images from over 1,800 patients in two distinct cancer types, we demonstrate superior prognostic performance over conventional segmentation analyses. The method autonomously identified previously unknown and potentially clinically actionable biological patterns. In lung adenocarcinoma, these include a Ki67-mediated immune evasion phenotype, a subcellular pattern of GLB1 expression which aligns with low-grade EGFR-driven tumours, and distinct modes of tumour-immune interaction in PD-L1+ patients. We also find a regulatory T-cell-mediated immunosupressive environment promoting tumour budding in colorectal carcinoma. Our work establishes SSL as a powerful, scalable, and unbiased platform to decode tissue ecosystems while being fully explainable without pre-defined hypotheses. This paradigm shift transforms high-plex imaging from a hypothesis-testing tool into a hypothesis-generating engine that can accelerate the discovery of next-generation spatial biomarkers.},
  citations={1},
  cites={8674196667073031948},
  selected={true}
}

@article{alkhalidi2026cyclops,
  abbr={bioRxiv},
  title={CYCLOPS: an open end-to-end platform for cyclic multiplex imaging and single-cell phenotyping},
  author={Al-Khalidi, S. and Paul, N. and Al-Khalidi, M. and Powley, I. and Carlin, L. and Farndale, Lucas and Roberts, E.},
  journal={bioRxiv},
  year={2026},
  month={jun},
  doi={10.64898/2026.06.11.731276},
  url={https://doi.org/10.64898/2026.06.11.731276},
  note={Preprint},
  abstract={Multiplex immunofluorescent imaging enables deep spatial profiling of protein expression in tissues but is often limited by reliance on proprietary reagents, dedicated hardware, and closed analysis ecosystems. Here we present CYCLOPS (Cyclic Open Platform for Spatial Proteomics), an end-to-end, open-source workflow for cyclic multiplex imaging and single-cell phenotyping using standard microscopy infrastructure. CYCLOPS integrates an Arduino-based automated fluidics system, an open-chamber stage insert, and antibody-oligonucleotide conjugation based entirely on published chemistries and off-the-shelf components. We demonstrate robust and reproducible antibody conjugation, high-quality multiplexed staining, and stable imaging across >10 cycles with minimal drift and consistent fluorescence retention with low signal carry-over. To enable quantitative analysis, we establish an open-source image processing and analysis pipeline for single-cell feature extraction and phenotypic classification, avoiding reliance on proprietary software or black-box workflows. Together, CYCLOPS provides a flexible and accessible platform for cyclic multiplex imaging, lowering barriers to adoption and enabling broader use of spatial proteomics across diverse research settings.},
  citations={1},
  cites={10744516311622473407}
}

@article{bryce2026morphospatial,
  abbr={bioRxiv},
  title={Morphospatial Profiling of Cancer-Associated Fibroblasts Reveals Architectural Subtypes of Pancreatic Ductal Adenocarcinoma},
  author={Bryce, A. S. and Martinelli, S. and Schubert Santana, L. and Officer-Jones, L. and Baird, R. L. and Ballantyne, F. and Rakovic, K. and Powley, I. R. and Tataran, D. and Meltzer, D. J. and Walsh, C. and Duthie, F. and Farndale, Lucas and Claudio Quiros, A. and Yuan, Ke and Le Quesne, J. and Froeling, F. E. and Dreyer, S. B. and Chang, D. K.},
  journal={bioRxiv},
  year={2026},
  month={feb},
  doi={10.64898/2026.02.06.704414},
  url={https://doi.org/10.64898/2026.02.06.704414},
  note={Preprint},
  abstract={Pancreatic ductal adenocarcinoma (PDAC) is a lethal malignancy with an urgent need for biomarkers to predict prognosis and guide treatment. Using a multi-omics approach across multiple spatial resolutions in a large human PDAC cohort, we integrate geometry and shape to define discrete morphological CAF subtypes, expanding CAF phenotyping beyond conventional proteomics. We then reveal an architectural and molecular axis of PDAC at tissue level, suggestive of epithelial-stromal co-evolution, and introduce four internally validated architectural subtypes of PDAC, each characterised by a common microenvironment and CAF enrichment profile. These archetypes outperform conventional pathology in prognostication, and predict response to adjuvant chemotherapy.}
}

